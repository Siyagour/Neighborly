# ============================================================
# Neighborly Android — .gitignore
# ============================================================

# ----- Built Application & Intermediate Artifacts ----------
*.apk
*.aar
*.ap_
*.aab
*.dex
*.class
app/release/

# ----- Gradle build outputs & caches -----------------------
.gradle/
*/.gradle/
build/
*/build/
app/build/

# ----- Local Machine Configuration (SDK paths, etc.) -------
local.properties

# ----- Keystore, Signing Keys & Secrets -------------------
*.jks
*.keystore
*.key
keystore.properties

# ----- Android Studio & IntelliJ IDEA ----------------------
# Module files
*.iml
*.ipr
*.iws

# User-specific & volatile IDE state (do NOT commit)
.idea/workspace.xml
.idea/**/workspace.xml
.idea/tasks.xml
.idea/**/tasks.xml
.idea/caches/
.idea/shelf/
.idea/libraries/
.idea/assetWizardSettings.xml
.idea/deploymentTargetSelector.xml
.idea/navEditor.xml
.idea/usageTracker.xml
.idea/render.experimental.xml
.idea/.DS_Store

# Note: The following shared project files remain tracked:
# .idea/gradle.xml, .idea/misc.xml, .idea/compiler.xml,
# .idea/runConfigurations/, .idea/vcs.xml, .idea/AndroidProjectSystem.xml

# ----- Android Studio Profiler, Captures & Native ----------
*.hprof
captures/
.navigation/
.cxx/
cmakeBuild/

# ----- Logs & Diagnostic Reports ---------------------------
*.log
lint/
reports/

# ----- OS-Generated Junk -----------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# ----- Merge & Patch Artifacts -----------------------------
*.orig
*.rej
*~

# ----- Kotlin Scratch / Temp Files -------------------------
*.kts.iml
